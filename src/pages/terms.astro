---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Terms of Service: Krillion Hints';
const pageDescription = 'Terms of Service for krillionhints.com.';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 space-y-8">
    <h1 class="text-3xl font-black text-white">Terms of Service</h1>
    <div class="bg-ocean-card border border-ocean-border rounded-2xl p-6 sm:p-10 space-y-6 text-sm text-krill-muted leading-relaxed">
      <h2 class="text-lg font-bold text-white">1. Use of Content</h2>
      <p>Content provided on krillionhints.com is for personal educational and entertainment purposes.</p>
    </div>
  </div>
</Layout>
