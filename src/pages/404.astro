---
import Layout from '../layouts/Layout.astro';

const pageTitle = '404: Lost in the Abyss - Krillion Hints';
const pageDescription = 'The prompt or page you are looking for has sunk beyond recovery. Return to today\'s daily dive hints.';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-xl mx-auto px-4 py-20 text-center space-y-6">
    <span class="text-6xl animate-pulse block">🦐 ⚓</span>
    <h1 class="text-4xl font-black text-white">404: Lost in the Trench</h1>
    <p class="text-sm text-krill-muted leading-relaxed">
      This coordinate has drifted beyond 7,000 meters. Let's resurface back to today's active prompts.
    </p>
    <div>
      <a
        href="/"
        class="inline-block px-6 py-3 bg-trench-cyan text-ocean-darkest font-bold text-xs font-mono-code rounded-xl shadow-cyan-glow hover:bg-trench-neon transition-all"
      >
        ← Return to Today's Dive Hints
      </a>
    </div>
  </div>
</Layout>
