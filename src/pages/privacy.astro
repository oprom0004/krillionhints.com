---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Privacy Policy: Krillion Hints';
const pageDescription = 'Privacy Policy for krillionhints.com.';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 space-y-8">
    <h1 class="text-3xl font-black text-white">Privacy Policy</h1>
    <div class="bg-ocean-card border border-ocean-border rounded-2xl p-6 sm:p-10 space-y-6 text-sm text-krill-muted leading-relaxed">
      <p>Last updated: October 2, 2026</p>
      <h2 class="text-lg font-bold text-white">1. Information We Collect</h2>
      <p>We do not collect personal accounts or private data. Anonymous analytics and cookie files may be used by advertising partners such as Google AdSense.</p>
    </div>
  </div>
</Layout>
