---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'How to Dive 7,000 Meters in Krillion: The Ultimate Strategy Guide';
const pageDescription = 'Master the art of scoring 7,000m in Krillion. Learn how to identify obscure sinkers, avoid the Too-Clever trap, and maximize your depth score on every prompt.';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'How to Reach 7,000m in Krillion (Strategy & Tips)',
    description: 'Expert strategies for picking rare answers and achieving perfect 7,000m dives in Krillion.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://krillionhints.com/' },
      { '@type': 'ListItem', position: 2, name: '7000m Strategy Guide', item: 'https://krillionhints.com/how-to-dive-7000m/' },
    ],
  },
];
---

<Layout title={pageTitle} description={pageDescription} schema={schemas}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8">
    <div class="text-center space-y-3">
      <div class="inline-flex items-center gap-2">
        <span class="px-3 py-1 bg-trench-cyan/15 text-trench-cyan border border-trench-cyan/30 text-xs font-black rounded-full font-mono-code uppercase tracking-wider">
          Masterclass Guide
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        How to Dive <span class="text-trench-cyan font-pixel text-4xl">7,000M</span> in Krillion
      </h1>
      <p class="text-sm sm:text-base text-krill-muted">
        The definitive tactical guide to escaping the surface floaters and sinking straight to the trench floor.
      </p>
    </div>

    <article class="bg-ocean-card border border-ocean-border rounded-2xl p-6 sm:p-10 space-y-8 text-sm sm:text-base leading-relaxed text-krill-text">
      <!-- Strategy 1 -->
      <section class="space-y-3">
        <h2 class="text-xl font-black text-white flex items-center gap-2 border-b border-ocean-border pb-2">
          <span>🧠</span> 1. Understand the "Too Clever" Phenomenon
        </h2>
        <p class="text-krill-muted">
          In Krillion, your score is determined by how many <em>other people</em> wrote the same answer. The biggest mistake novice players make is picking the most famous "obscure" trivia answer.
        </p>
        <div class="p-4 bg-ocean-dark rounded-xl border border-amber-900/40 text-xs space-y-1">
          <p class="text-amber-400 font-bold">⚠️ Classic Example: "Shakespeare Plays"</p>
          <p class="text-krill-muted">Everyone knows Hamlet is too common, so thousands of players jump to <em>Titus Andronicus</em> thinking it's rare. That makes Titus "Too Clever" and lowers its depth score!</p>
        </div>
      </section>

      <!-- Strategy 2 -->
      <section class="space-y-3">
        <h2 class="text-xl font-black text-white flex items-center gap-2 border-b border-ocean-border pb-2">
          <span>🎯</span> 2. The 3-Tier Rule of Obscurity
        </h2>
        <ul class="space-y-2 list-disc list-inside text-krill-muted">
          <li><strong>Tier 1 (Surface Floaters · 0m - 1500m):</strong> The first 3 things that pop into your head. Never type these.</li>
          <li><strong>Tier 2 (The Trap Zone · 2000m - 4500m):</strong> The "smart" answers that high school textbooks mention.</li>
          <li><strong>Tier 3 (Abyssal Trench · 6000m - 7000m):</strong> Academic, regional, microstate, or technical specifics.</li>
        </ul>
      </section>

      <!-- Strategy 3 -->
      <section class="space-y-3">
        <h2 class="text-xl font-black text-white flex items-center gap-2 border-b border-ocean-border pb-2">
          <span>⏱️</span> 3. Master the 25-Second Time Constraint
        </h2>
        <p class="text-krill-muted">
          You only have 25 seconds per prompt. Do not spend 20 seconds hesitating! If you have a Tier 3 answer in mind, type it immediately to ensure no spelling errors cost you the entire 7,000m depth.
        </p>
      </section>

      <!-- CTA -->
      <div class="p-5 bg-ocean-dark rounded-xl border border-trench-cyan/30 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h4 class="font-bold text-white text-sm">Explore Today's Prompts</h4>
          <p class="text-xs text-krill-muted">Check out our pre-screened 7,000m sinker answers for today.</p>
        </div>
        <a href="/" class="px-4 py-2 bg-trench-cyan text-ocean-darkest font-bold text-xs font-mono-code rounded-lg shadow-cyan-glow whitespace-nowrap">
          View Today's Hints →
        </a>
      </div>
    </article>
  </div>
</Layout>
